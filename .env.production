# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
#  Commune — production .env TEMPLATE for cPanel (commune.kdiscmis.org.in)
#
#  On the first deploy, deploy/cpanel/deploy.sh copies this file to the app directory as .env (permissions 600)
#  and fills in APP_KEY. After that, edit ONLY that server copy:
#      /home/shooting/apps/commune/.env      (cPanel → File Manager, or SSH)
#  Later deploys never overwrite it.
#
#  ⚠  This template is committed to git. NEVER put real passwords or keys in this file.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────

APP_NAME=Commune
APP_ENV=production
APP_DEBUG=false
APP_URL=https://commune.kdiscmis.org.in

# Encryption key for Aadhaar numbers (libsodium). Generated automatically on the first deploy.
# BACK IT UP OFFLINE, apart from the database backups. If it is lost or changed, stored Aadhaar numbers can never be
# decrypted again. Never change it once visitors have registered.
APP_KEY=
LOG_LEVEL=info

# cPanel → MySQL® Databases: create the database and user, add the user to the database with ALL PRIVILEGES.
# cPanel prefixes both names with the account name (shooting_…).
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=shooting_commune
DB_USERNAME=shooting_commune
DB_PASSWORD=CHANGE_ME
# DB_SOCKET=/var/lib/mysql/mysql.sock

SESSION_SECURE_COOKIE=true    # HTTPS only (turn on AutoSSL for the subdomain)
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Leave empty unless the site sits behind a proxy/CDN you control (e.g. Cloudflare: list its IP ranges).
TRUSTED_PROXIES=
RATE_LIMITS=true

# Footer social links (shown only when set)
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=

# cPanel → Email Accounts: create the sender mailbox, then use its SMTP details ("Connect Devices").
# Encode "@" in the username as %40. Port 465 = SSL; for 587 (STARTTLS) use smtp://…:587
MAIL_DSN=smtp://no-reply%40kdiscmis.org.in:CHANGE_ME@mail.kdiscmis.org.in:465
MAIL_FROM_ADDRESS=no-reply@kdiscmis.org.in
MAIL_FROM_NAME="Commune Kottarakara"
MAIL_REPLY_TO=commune.ktr@kdisc.kerala.gov.in
