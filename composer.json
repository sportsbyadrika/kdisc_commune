{
    "name": "kdisc/commune",
    "description": "Commune Workspace Management System - K-DISC, Kottarakara",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.0",
        "intervention/image": "^3.7",
        "monolog/monolog": "^3.7",
        "phpoffice/phpspreadsheet": "^5.0",
        "symfony/mailer": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeds\\": "database/seeds/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "serve": "php -S 127.0.0.1:8000 -t public public/index.php",
        "lint": "find app bin config database public routes resources/views tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
