# Commune — Apache / LiteSpeed rules for the web root (point the DocumentRoot here; see docs/DEPLOYMENT.md).
#
# Shared-hosting safe on purpose: only mod_rewrite (AllowOverride FileInfo) is required. No "Options", "Require",
# "<If>" or "DirectoryIndex" lines — hardened cPanel hosts reject those in .htaccess with an HTTP 500 for every
# request ("Option MultiViews not allowed here"). Header rules are optional (mod_headers).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .user.ini, .git …) — except /.well-known/ (AutoSSL, domain validation)
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Old-style .php URLs → clean URL (/pricing.php → /pricing); the front controller itself is left alone
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/(index|diagnose)\.php$ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Hide /index.php from URLs
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?/] [NC]
    RewriteRule ^index\.php/?(.*)$ /$1 [R=301,L,NE]

    # Pass the Authorization header to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Front controller: everything that is not a real file goes to index.php (directories too — so "/" works
    # without DirectoryIndex and folders like /assets/ are never listed)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?)$">
        # asset() URLs carry a content hash (?v=…), so these can be cached for a year
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    <FilesMatch "\.(svg|webp|png|jpe?g|gif|ico)$">
        Header set Cache-Control "public, max-age=604800"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>
