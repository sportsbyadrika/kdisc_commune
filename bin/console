#!/usr/bin/env php
<?php

/**
 * Commune console.
 *
 *   php bin/console migrate              Run pending migrations
 *   php bin/console migrate:fresh [--seed]  Drop all tables and re-run migrations (DEV ONLY)
 *   php bin/console migrate:status       List migrations
 *   php bin/console db:seed [--class=X]  Run DatabaseSeeder (or one seeder class in database/seeds)
 *   php bin/console make:migration name  Create an empty SQL migration
 *   php bin/console key:generate         Print a new APP_KEY for .env
 *   php bin/console routes               List registered routes
 *   php bin/console bookings:tick        Scheduled booking lifecycle: activate on start date, complete after end
 *                                        date, expire unpaid approvals, renewal reminders (idempotent; cron)
 *   php bin/console holds:cleanup        Delete expired seat holds (cron)
 *   php bin/console imports:cleanup      Delete expired bulk-upload temp files (cron, hourly)
 *   php bin/console user:create --name="Full Name" --email=a@b.c --role=centre_manager [--invite]
 *                                        Create a staff user (first manager on a new server). Prompts for the
 *                                        password (hidden), or --invite emails a set-password link instead.
 *   php bin/console app:check            Environment report: PHP version/extensions, writable dirs, APP_KEY, DB,
 *                                        pending migrations, mail, demo logins, cron freshness (exit 1 on FAIL)
 *   php bin/console demo:seed            Load ~30 visitors / ~40 bookings / payments / invoices through the real services
 *                                        for UAT (refuses when APP_ENV=production; run after migrate:fresh --seed)
 */

declare(strict_types=1);

use App\Core\App;
use App\Core\Database;
use App\Core\Migrator;
use App\Core\Router;

$basePath = dirname(__DIR__);
require $basePath . '/vendor/autoload.php';

App::boot($basePath);

$argv = $_SERVER['argv'];
array_shift($argv);
$command = $argv[0] ?? 'help';
$options = [];
$args = [];
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--')) {
        [$k, $v] = array_pad(explode('=', substr($arg, 2), 2), 2, true);
        $options[$k] = $v;
    } else {
        $args[] = $arg;
    }
}

$out = static function (string $line): void {
    fwrite(STDOUT, $line . PHP_EOL);
};
$fail = static function (string $line): never {
    fwrite(STDERR, "\033[31m{$line}\033[0m" . PHP_EOL);
    exit(1);
};

$migrator = static fn (): Migrator => new Migrator(
    Database::getInstance(),
    $basePath . '/' . App::config('database.migrations_path', 'database/migrations'),
    $out,
);

$seed = static function (string $class) use ($out, $fail): void {
    $fqcn = str_contains($class, '\\') ? $class : 'Database\\Seeds\\' . $class;
    if (!class_exists($fqcn)) {
        $fail("Seeder [{$fqcn}] not found.");
    }
    $start = microtime(true);
    (new $fqcn(Database::getInstance(), $out))->run();
    $out(sprintf('Seeding complete (%.1f s).', microtime(true) - $start));
};

try {
    switch ($command) {
        case 'migrate':
            $migrator()->migrate();
            if (isset($options['seed'])) {
                $seed('DatabaseSeeder');
            }
            break;

        case 'migrate:fresh':
            if (App::config('app.env') === 'production' && !isset($options['force'])) {
                $fail('Refusing to drop tables in production. Use --force if you really mean it.');
            }
            $migrator()->fresh();
            if (isset($options['seed'])) {
                $seed('DatabaseSeeder');
            }
            break;

        case 'migrate:status':
            foreach ($migrator()->status() as $row) {
                $out(sprintf('%s  %-60s %s', $row['ran'] ? "\033[32mRan \033[0m" : "\033[33mPend\033[0m", $row['migration'], $row['batch'] !== null ? 'batch ' . $row['batch'] : ''));
            }
            break;

        case 'db:seed':
            $seed(is_string($options['class'] ?? null) ? $options['class'] : 'DatabaseSeeder');
            break;

        case 'make:migration':
            $name = preg_replace('/[^a-z0-9_]+/', '_', strtolower($args[0] ?? '')) ?: $fail('Usage: make:migration create_things_table');
            $file = sprintf('%s/database/migrations/%s_%s.sql', $basePath, date('Y_m_d_His'), trim($name, '_'));
            file_put_contents($file, "-- " . $name . "\n\n");
            $out('Created ' . str_replace($basePath . '/', '', $file));
            break;

        case 'key:generate':
            $out('APP_KEY=base64:' . base64_encode(random_bytes(SODIUM_CRYPTO_SECRETBOX_KEYBYTES)));
            break;

        case 'routes':
            /** @var Router $router */
            $router = App::container()->get(Router::class);
            foreach ($router->routes() as $route) {
                $action = $route->action();
                $target = is_array($action) ? (is_string($action[0]) ? $action[0] : get_class($action[0])) . '@' . $action[1] : 'Closure';
                $out(sprintf('%-10s %-38s %-28s %s  [%s]', implode('|', array_diff($route->methods(), ['HEAD'])), $route->uri(), $route->getName() ?? '', str_replace('App\\Controllers\\', '', $target), implode(', ', $route->getMiddleware())));
            }
            break;

        case 'bookings:tick':
            /** @var \App\Services\Bookings\BookingTicker $ticker */
            $ticker = App::container()->get(\App\Services\Bookings\BookingTicker::class);
            $start = microtime(true);
            $r = $ticker->run();
            \App\Services\System\EnvironmentCheck::stamp($basePath, 'bookings:tick');
            $out(sprintf(
                'bookings:tick  activated %d · completed %d · expired %d · reminders %d  (%.2f s)',
                $r['activated'], $r['completed'], $r['expired'], $r['reminders'], microtime(true) - $start,
            ));
            foreach ($r['errors'] as $err) {
                fwrite(STDERR, '  ! ' . $err . PHP_EOL);
            }
            if ($r['errors'] !== []) {
                exit(1);
            }
            break;

        case 'holds:cleanup':
            /** @var \App\Services\Space\SeatHoldService $holds */
            $holds = App::container()->get(\App\Services\Space\SeatHoldService::class);
            $out(sprintf('holds:cleanup  removed %d expired seat hold(s)', $holds->purgeExpired()));
            \App\Services\System\EnvironmentCheck::stamp($basePath, 'holds:cleanup');
            break;

        case 'imports:cleanup':
            /** @var \App\Services\Imports\ImportService $imports */
            $imports = App::container()->get(\App\Services\Imports\ImportService::class);
            $out(sprintf('imports:cleanup  expired %d upload(s)', $imports->cleanupExpired()));
            \App\Services\System\EnvironmentCheck::stamp($basePath, 'imports:cleanup');
            // housekeeping for the request rate limiter as well
            App::container()->get(\App\Services\Security\RateLimiter::class)->purge();
            break;

        case 'user:create':
            $role = \App\Enums\StaffRole::tryFrom(is_string($options['role'] ?? null) ? $options['role'] : '')
                ?? $fail('Usage: user:create --name="Full Name" --email=you@example.org --role=' . implode('|', \App\Enums\StaffRole::values()) . ' [--invite]');
            $name = is_string($options['name'] ?? null) ? trim($options['name']) : '';
            $email = is_string($options['email'] ?? null) ? mb_strtolower(trim($options['email'])) : '';
            if (mb_strlen($name) < 2 || filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
                $fail('A --name (2+ characters) and a valid --email are required.');
            }
            /** @var \App\Services\Staff\StaffUserService $staffUsers */
            $staffUsers = App::container()->get(\App\Services\Staff\StaffUserService::class);
            if (isset($options['invite'])) {
                $id = $staffUsers->createWithPassword($name, $email, $role, bin2hex(random_bytes(24)));
                \App\Models\StaffUser::update($id, ['password_changed_at' => null]);
                $sent = $staffUsers->sendLink((array) \App\Models\StaffUser::find($id), \App\Enums\TokenPurpose::Invite);
                $out(sprintf('Created %s (%s, id %d). Invite %s.', $email, $role->label(), $id, $sent ? 'emailed' : 'NOT sent — check MAIL_DSN, then use "Resend invite" in /staff/users'));
                break;
            }
            $ask = static function (string $prompt): string {
                fwrite(STDOUT, $prompt);
                $tty = function_exists('posix_isatty') && posix_isatty(STDIN);
                if ($tty) {
                    shell_exec('stty -echo');
                }
                $line = rtrim((string) fgets(STDIN), "\r\n");
                if ($tty) {
                    shell_exec('stty echo');
                    fwrite(STDOUT, PHP_EOL);
                }
                return $line;
            };
            $password = $ask('Password (8+ chars, upper & lower case, a number and a symbol): ');
            $validator = \App\Core\Validator::make(['password' => $password, 'password_confirmation' => $ask('Repeat password: ')], ['password' => 'required|password|confirmed']);
            if ($validator->fails()) {
                $fail(implode(' ', array_merge(...array_values($validator->errors()))));
            }
            $id = $staffUsers->createWithPassword($name, $email, $role, $password);
            $out(sprintf('Created %s (%s, id %d). Sign in at %s', $email, $role->label(), $id, absolute_url('staff.login')));
            break;

        case 'app:check':
            $checks = (new \App\Services\System\EnvironmentCheck($basePath))->run();
            $colour = ['ok' => "\033[32m OK \033[0m", 'warn' => "\033[33mWARN\033[0m", 'fail' => "\033[31mFAIL\033[0m"];
            $group = '';
            foreach ($checks as $c) {
                if ($c['group'] !== $group) {
                    $group = $c['group'];
                    $out(PHP_EOL . $group);
                }
                $out(sprintf('  [%s] %-34s %s', $colour[$c['status']], $c['name'], $c['detail']));
            }
            $counts = array_count_values(array_column($checks, 'status'));
            $out(PHP_EOL . sprintf('%d ok · %d warning(s) · %d failure(s)', $counts['ok'] ?? 0, $counts['warn'] ?? 0, $counts['fail'] ?? 0));
            if (($counts['fail'] ?? 0) > 0) {
                exit(1);
            }
            break;

        case 'demo:seed':
            if (App::config('app.env') === 'production') {
                $fail('Refusing to load demo data when APP_ENV=production.');
            }
            /** @var \App\Services\Demo\DemoSeeder $demo */
            $demo = App::container()->get(\App\Services\Demo\DemoSeeder::class);
            $start = microtime(true);
            $counts = $demo->run($out);
            $out(sprintf('Demo data loaded (%.1f s): %s', microtime(true) - $start, implode(', ', array_map(static fn ($k, $v) => "{$v} {$k}", array_keys($counts), $counts))));
            $out('Staff logins (password Password@123): reception@ / manager@ / finance@ / stateadmin@commune.test');
            break;

        default:
            $doc = (string) file_get_contents(__FILE__);
            preg_match('#/\*\*(.*?)\*/#s', $doc, $m);
            $out(trim(preg_replace('/^\s*\* ?/m', '', $m[1] ?? '') ?? ''));
    }
} catch (Throwable $e) {
    $fail(get_class($e) . ': ' . $e->getMessage());
}
