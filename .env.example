# Copy to .env and adjust. Never commit .env.
APP_NAME=Commune
APP_ENV=local            # local | production
APP_DEBUG=true           # MUST be false in production
APP_URL=http://localhost:8000
# Encryption key for Aadhaar numbers (libsodium). Generate with: php bin/console key:generate
# BACK IT UP OFFLINE — if it is lost or changed, stored Aadhaar numbers can never be decrypted again.
APP_KEY=
LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commune
DB_USERNAME=commune
DB_PASSWORD=commune
# DB_SOCKET=/run/mysqld/mysqld.sock

SESSION_SECURE_COOKIE=false   # true behind HTTPS (also auto-enabled when the request is HTTPS)
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12     # a session ends after this long, however active

# Reverse proxy / load balancer IPs whose X-Forwarded-For / -Proto may be trusted (comma separated; empty = none)
TRUSTED_PROXIES=
# Route rate limits (throttle middleware). Keep true in production.
RATE_LIMITS=true
# LOG_PATH=storage/logs/app.log

# Footer social links (shown only when set)
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=

MAIL_DSN=log://default        # dev: storage/logs/mail.log + storage/mail/*.eml; prod: smtp://user:pass@smtp.example.com:587
MAIL_FROM_ADDRESS=no-reply@commune.test
MAIL_FROM_NAME="Commune Kottarakara"
