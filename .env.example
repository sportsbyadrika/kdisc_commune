# Copy to .env and adjust. Never commit .env.
APP_NAME=Commune
APP_ENV=local            # local | production
APP_DEBUG=true           # MUST be false in production
APP_URL=http://localhost:8000
# Encryption key for Aadhaar numbers (libsodium). Generate with: php bin/console key:generate
APP_KEY=
LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commune
DB_USERNAME=commune
DB_PASSWORD=commune
# DB_SOCKET=/run/mysqld/mysqld.sock

SESSION_SECURE_COOKIE=false   # true behind HTTPS (also auto-enabled when the request is HTTPS)
SESSION_IDLE_MINUTES=120

MAIL_DSN=null://null          # e.g. smtp://user:pass@smtp.example.com:587
MAIL_FROM_ADDRESS=no-reply@commune.test
MAIL_FROM_NAME="Commune Kottarakara"
